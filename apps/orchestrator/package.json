{
  "name": "youtube-shorts-orchestrator",
  "version": "0.1.0",
  "description": "AI pipeline for generating educational YouTube Shorts using LangGraph.",
  "packageManager": "pnpm@10.34.3",
  "main": "src/graph/index.ts",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "npx @langchain/langgraph-cli dev --server-log-level warn",
    "clean": "rm -rf dist",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=\\.test\\.ts$ --testPathIgnorePatterns=\\.int\\.test\\.ts$",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=\\.int\\.test\\.ts$",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "oxlint src --config ../../.oxlintrc.json --import-plugin --deny-warnings",
    "format:check": "prettier --check .",
    "lint:langgraph-json": "node scripts/checkLanggraphPaths.js",
    "lint:all": "pnpm lint && pnpm lint:langgraph-json && pnpm format:check",
    "test:all": "pnpm test && pnpm test:int && pnpm lint:langgraph-json"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "execa": "^10.0.1",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "oxlint": "^1.78.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.11",
    "typescript": "^7.0.2"
  }
}
