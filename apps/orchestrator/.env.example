# Copy this over:
# cp .env.example .env
# Then modify to suit your needs

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ============================================================================
# Default (fallback for any agent not explicitly overridden)
# ============================================================================
DEFAULT_MODEL=deepseek/deepseek-v4-flash

# ============================================================================
# Premium reasoning / research
# ============================================================================
MODEL_RESEARCHAGENT=deepseek/deepseek-v4-flash
MODEL_RESEARCHCOLLECTOR=deepseek/deepseek-v4-flash
MODEL_SCRIPTWRITER=deepseek/deepseek-v4-flash

# ============================================================================
# Editorial / creative
# ============================================================================
MODEL_SCRIPTPLANNER=qwen/qwen3.7-flash
MODEL_VISUALDIRECTOR=qwen/qwen3.7-flash
MODEL_IMAGEPROMPTGENERATOR=qwen/qwen3.7-flash
MODEL_PROMPTENGINEER=qwen/qwen3.7-flash
MODEL_NARRATIONPLANNER=qwen/qwen3.7-flash

# ============================================================================
# QA / verification
# ============================================================================
MODEL_RESEARCHQA=deepseek/deepseek-v4-flash
MODEL_SCRIPTQA=deepseek/deepseek-v4-flash
MODEL_PROMPTQA=deepseek/deepseek-v4-flash
MODEL_QAREVIEWER=deepseek/deepseek-v4-flash
MODEL_RELEASEVALIDATION=deepseek/deepseek-v4-flash
MODEL_RELEASEREVIEW=deepseek/deepseek-v4-flash

# ============================================================================
# QA feature flags (default off; ENABLE_QA turns every stage on)
# ============================================================================
ENABLE_QA=false
ENABLE_SCRIPT_QA=false
ENABLE_RESEARCH_QA=false
ENABLE_PROMPT_QA=false
ENABLE_RELEASE_QA=false

# ============================================================================
# Metadata
# ============================================================================
MODEL_METADATAWRITER=qwen/qwen3.7-flash
MODEL_METADATAGENERATOR=qwen/qwen3.7-flash
MODEL_THUMBNAILGENERATOR=qwen/qwen3.7-flash

# ============================================================================
# Provider-backed nodes (kept for consistency; model usually unused)
# ============================================================================
MODEL_ASSETGENERATOR=qwen/qwen3.7-flash
MODEL_NARRATIONGENERATOR=qwen/qwen3.7-flash
MODEL_SUBTITLEGENERATOR=qwen/qwen3.7-flash
MODEL_VIDEOCOMPOSER=qwen/qwen3.7-flash
MODEL_PUBLISHER=qwen/qwen3.7-flash

USE_REAL_PROVIDERS=true

# Set true to generate video assets (runway provider). Off by default:
# "video" scenes fall back to image generation until video is supported.
ENABLE_VIDEO_ASSETS=false

# ============================================================================
# Optional; sane defaults if unset
# ============================================================================
# NODE_ENV=development
# IMAGE_PROVIDER_URL=http://localhost:8020
# TTS_URL=http://localhost:8010
# WhisperX word-level alignment service (separate process on :8030)
# Local development
TRANSCRIBER_URL=http://localhost:8030
# ARTIFACT_STORE_ENABLED=false
# ARTIFACT_STORE_DIR=runs
# SOURCE_ASSET_CACHE_DIR=cache/source-assets
# NARRATIVE_HOLD_SECONDS=0.5
