# ============================================================================
# API Keys
# ============================================================================

# Copy this over:
# cp .env.example .env
# Then modify to suit your needs

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LLM request timeouts (streaming-aware). Abort waiting for the first streamed
# chunk after LLM_FIRST_TOKEN_TIMEOUT_MS, then abort only if the stream stays
# silent for LLM_STREAM_INACTIVITY_TIMEOUT_MS. No absolute cap on total
# generation length while chunks keep arriving.
# LLM_FIRST_TOKEN_TIMEOUT_MS=90000
# LLM_STREAM_INACTIVITY_TIMEOUT_MS=120000

# ============================================================================
# Model Assignments — Research / Script
# ============================================================================

MODEL_RESEARCHAGENT=openai/gpt-5.6-luna
MODEL_RESEARCHCOLLECTOR=z-ai/glm-5.3-flash
MODEL_SCRIPTWRITER=openai/gpt-5.6-luna

# ============================================================================
# Model Assignments — Editorial / Creative
# ============================================================================

MODEL_SCRIPTPLANNER=z-ai/glm-5.3-flash
MODEL_VISUALDIRECTOR=minimax/minimax-m3:free
MODEL_IMAGEPROMPTGENERATOR=minimax/minimax-m3:free
MODEL_PROMPTENGINEER=upstage/solar-pro4
MODEL_NARRATIONPLANNER=z-ai/glm-5.3-flash

# ============================================================================
# Model Assignments — QA / Verification
# ============================================================================

MODEL_RESEARCHQA=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_SCRIPTQA=minimax/minimax-m3:free
MODEL_PROMPTQA=z-ai/glm-5.3-flash
MODEL_QAREVIEWER=minimax/minimax-m3:free
MODEL_RELEASEVALIDATION=upstage/solar-pro4
MODEL_RELEASEREVIEW=nvidia/nemotron-3-ultra-550b-a55b:free

# ============================================================================
# Model Assignments — Metadata / Thumbnail
# ============================================================================

MODEL_METADATAWRITER=upstage/solar-pro4
MODEL_METADATAGENERATOR=upstage/solar-pro4
MODEL_THUMBNAILGENERATOR=minimax/minimax-m3:free

# ============================================================================
# Model Assignments — Provider-backed / System Nodes
# ============================================================================

MODEL_ASSETSTRATEGY=upstage/solar-pro4
MODEL_ASSETGENERATOR=upstage/solar-pro4
MODEL_NARRATIONGENERATOR=upstage/solar-pro4
MODEL_SUBTITLEGENERATOR=upstage/solar-pro4
MODEL_VIDEOCOMPOSER=upstage/solar-pro4
MODEL_PUBLISHER=upstage/solar-pro4

# ============================================================================
# QA Flags
# ============================================================================

ENABLE_QA=true

ENABLE_SCRIPT_QA=true
ENABLE_RESEARCH_QA=true
ENABLE_PROMPT_QA=true

# Keep disabled unless release approval is fully automated.
ENABLE_RELEASE_QA=false

THUMBNAIL_QA=false

# ============================================================================
# Classifier Layer (bounded QA decisions — TypeSafe/Jev)
# ============================================================================
# Master switch. "off" (default) keeps every QA gate on its existing LLM
# path; "typesafe" routes enabled gates through the classifier first:
#   high-confidence pass     -> verdict without an LLM call
#   high-confidence non-pass -> verdict + LLM cascade for feedback prose
#   low confidence / error   -> abstain to the existing LLM path
# CLASSIFIER_PROVIDER=off                  # off | typesafe
# TYPESAFE_API_KEY=                        # required when provider=typesafe
# TYPESAFE_DEFAULT_MODEL=jev-latest
#
# Per-gate flags (effective only when the provider is on; default enabled):
# CLASSIFIER_PROMPTQA=true
# CLASSIFIER_RESEARCHQA=true
# CLASSIFIER_RELEASEREVIEW=true
# CLASSIFIER_SCRIPTQA=true
#
# Per-gate confidence floor 0-1 (default 0.85). Tune per gate from
# scripts/qa-eval results — do not share one global threshold across gates.
# CLASSIFIER_PROMPTQA_CONFIDENCE_MIN=0.85
# CLASSIFIER_RESEARCHQA_CONFIDENCE_MIN=0.85
# CLASSIFIER_RELEASEREVIEW_CONFIDENCE_MIN=0.85
# CLASSIFIER_SCRIPTQA_CONFIDENCE_MIN=0.85

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_VIDEO_ASSETS=true
USE_REAL_PROVIDERS=true
YOUTUBE_PUBLISHING_ENABLED=true

# ============================================================================
# Provider URLs
# ============================================================================

NODE_ENV=development
IMAGE_PROVIDER_URL=http://localhost:8020
TTS_URL=http://localhost:8010
TRANSCRIBER_URL=http://localhost:8030

# ============================================================================
# TTS Provider Selection
# ============================================================================
# Which TTS backend narrates scenes. "chatterbox" talks to the local Chatterbox
# service on TTS_URL; "openrouter" talks to OpenRouter's /api/v1/audio/speech.
# TTS_PROVIDER=chatterbox            # or "openrouter"
#
# OpenRouter TTS uses the same OPENROUTER_API_KEY as the LLM nodes (no
# separate credential). The model identifier names the actual TTS model behind
# OpenRouter (currently fish-audio). The voice is provider/model-specific and
# is configuration, not part of the generic TTS contract.
# OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free
# OPENROUTER_TTS_VOICE=536d3a5e000945adb7038665781a4aca
# OPENROUTER_TTS_RESPONSE_FORMAT=mp3
# OPENROUTER_TTS_TIMEOUT_MS=300000

# Narration generation mode. "complete" synthesizes the entire narration in a
# single TTS request (uses content.narration, continuous/cohesive prosody);
# "scene" synthesizes each scene's narration independently and concatenates.
# Defaults to the TTS provider's natural mode: "complete" for openrouter,
# "scene" for chatterbox. Explicit values always win.
# NARRATION_GENERATION_MODE=complete

# ============================================================================
# Thumbnail Settings
# ============================================================================

ENABLE_THUMBNAIL=false
THUMBNAIL_MODE=auto            # auto | full | overlay
THUMBNAIL_FONT_PATH=assets/branding/NotoSans-Bold.ttf
# MODEL_THUMBNAILQA=openai/gpt-4o-mini   # vision-capable model used for thumbnail QA

# ============================================================================
# Narration / Timing
# ============================================================================

NARRATIVE_HOLD_SECONDS=0.5
# Speaking-rate target used by the long-form video profile to plan
# narration word counts. Falls back to NARRATION_TARGET_WPM if unset.
# WORDS_PER_MINUTE=160
NARRATION_TARGET_WPM=140

# ============================================================================
# Subtitle Settings (word-level karaoke highlighting)
# ============================================================================
# Word-karaoke subtitles render "white sentence + one accented word" following
# WhisperX word timestamps. Colors are ASS format (&HAABBGGRR). Font sizes are
# ASS pixels on a 1080x1920 (PlayResX/Y) canvas — much larger than UI px.
SUBTITLE_FONT_SIZE=48
SUBTITLE_FONT_NAME=Noto Sans
SUBTITLE_FONT_PATH=assets/branding/NotoSans-Bold.ttf
SUBTITLE_MARGIN_V=70             # bottom margin (smaller = closer to bottom edge)
SUBTITLE_PRIMARY_COLOR=&H00FFFFFF  # base text
SUBTITLE_ACCENT_COLOR=&H0000E0FF   # currently-spoken word
SUBTITLE_OUTLINE=2

# ============================================================================
# Artifacts / Caching
# ============================================================================

ARTIFACT_STORE_ENABLED=true
ARTIFACT_STORE_DIR=runs
SOURCE_ASSET_CACHE_DIR=cache/source-assets

# Source asset providers (optional; Wikimedia is always available)
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# PEXELS_API_KEY=your-pexels-api-key
# SOURCE_ASSET_DEADLINE_MS=60000

# ============================================================================
# YouTube Publishing (real uploads require explicit opt-in)
# ============================================================================
# Set true to actually upload to YouTube. Until then the publisher uses the
# stub provider, so a dev run can never publish to the internet by accident.
# Obtain the refresh token once via: node scripts/oauth-youtube.mjs
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional safety verification channel (used later via channels.list(mine=true)).
YOUTUBE_CHANNEL_ID=
# Optional overrides; defaults are shown.
# YOUTUBE_CATEGORY_ID=27
YOUTUBE_LANGUAGE=en
YOUTUBE_MADE_FOR_KIDS=false
# YOUTUBE_SYNTHETIC_MEDIA=true
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_PUBLISH_AT=2026-08-14T18:00:00Z
# YOUTUBE_PLAYLIST_IDS=PLxxxx,PLyyyy

# ============================================================================
# Google Sheets
# ============================================================================
# Write-back of publish records (Video ID, Category, Topic, Title, Status,
# YouTube ID, URL, Privacy, Scheduled At, Published At, Duration). Optional;
# auth reuses YOUTUBE_* credentials. Enabling requires re-running
# scripts/oauth-youtube.mjs to mint a refresh token that includes the
# spreadsheets scope.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_SHEET_NAME=Sheet1

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=debug

# ============================================================================
# Network runtime
# ============================================================================
# Google OAuth requires IPv4-only socket selection on hosts without IPv6.
# This is configured in-process by src/runtime/network.ts / network.mjs —
# do NOT set NODE_OPTIONS=--dns-result-order=ipv4first as the only fix
# (DNS ordering does not stop Happy Eyeballs from racing unroutable AAAA).