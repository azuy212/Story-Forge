# Copy this over:
# cp .env.example .env
# Then modify to suit your needs

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ============================================================================
# ULTIMATE HYBRID MODEL ASSIGNMENTS
#
# Strategy:
# - GPT-5.6 Luna: highest-value creative/reasoning decisions.
# - GLM 5.2: strong independent reasoning at zero model cost.
# - Nemotron Ultra: independent high-end QA / verification.
# - DeepSeek V4 Flash: fast research/extraction/segmentation.
# - Qwen Flash: cheap structured transformations.
# - Nemotron Lightning: provider-backed/system nodes.
# ============================================================================


# ============================================================================
# Default
# ============================================================================
DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731

# ============================================================================
# Research / Script
# ============================================================================

# Primary research reasoning.
MODEL_RESEARCHAGENT=openai/gpt-5.6-luna

# High-volume source extraction / summarization.
MODEL_RESEARCHCOLLECTOR=deepseek/deepseek-v4-flash-0731

# Final viewer-facing script.
MODEL_SCRIPTWRITER=openai/gpt-5.6-luna


# ============================================================================
# Editorial / Creative
# ============================================================================

# Story architecture, hook, pacing, information ordering.
MODEL_SCRIPTPLANNER=z-ai/glm-5.2:free

# High-level visual storytelling and shot decisions.
MODEL_VISUALDIRECTOR=openai/gpt-5.6-luna

# Converts visual direction into image-generation prompts.
MODEL_IMAGEPROMPTGENERATOR=qwen/qwen3.7-flash

# Prompt transformation / optimization.
MODEL_PROMPTENGINEER=qwen/qwen3.7-flash

# Narration timing / segmentation / delivery instructions.
MODEL_NARRATIONPLANNER=deepseek/deepseek-v4-flash-0731


# ============================================================================
# QA / Verification
# ============================================================================

# Independent factual verification.
MODEL_RESEARCHQA=nvidia/nemotron-3-ultra-550b-a55b:free

# Independent script critique.
MODEL_SCRIPTQA=z-ai/glm-5.2:free

# Prompt constraint / quality checking.
MODEL_PROMPTQA=qwen/qwen3.7-flash

# Final holistic reviewer.
MODEL_QAREVIEWER=openai/gpt-5.6-luna

# Deterministic / structural validation.
MODEL_RELEASEVALIDATION=qwen/qwen3.7-flash

# Final editorial release decision.
MODEL_RELEASEREVIEW=openai/gpt-5.6-luna


# ============================================================================
# QA flags
# ============================================================================

ENABLE_QA=true

ENABLE_SCRIPT_QA=true
ENABLE_RESEARCH_QA=true
ENABLE_PROMPT_QA=true

# Keep disabled unless release approval is fully automated.
ENABLE_RELEASE_QA=false


# ============================================================================
# Metadata / Thumbnail
# ============================================================================

MODEL_METADATAWRITER=qwen/qwen3.7-flash
MODEL_METADATAGENERATOR=qwen/qwen3.7-flash
MODEL_THUMBNAILGENERATOR=google/gemma-4-26b-a4b-it:free


# ============================================================================
# Provider-backed / system nodes
# ============================================================================

MODEL_ASSETSTRATEGY=nvidia/nemotron-3.5-lightning:free
MODEL_ASSETGENERATOR=nvidia/nemotron-3.5-lightning:free
# Prompt-repair node reasons about provider policy rejections and rewrites the
# prompt while preserving visual intent — keep it stronger than a SYSTEM model.
MODEL_IMAGEPROMPTREPAIR=nvidia/nemotron-3.5-lightning:free
MODEL_NARRATIONGENERATOR=nvidia/nemotron-3.5-lightning:free
MODEL_SUBTITLEGENERATOR=nvidia/nemotron-3.5-lightning:free
MODEL_VIDEOCOMPOSER=nvidia/nemotron-3.5-lightning:free
MODEL_PUBLISHER=nvidia/nemotron-3.5-lightning:free

USE_REAL_PROVIDERS=true

# ============================================================================
# YouTube publishing (real uploads require explicit opt-in)
# ============================================================================
# Set true to actually upload to YouTube. Until then the publisher uses the
# stub provider, so a dev run can never publish to the internet by accident.
# YOUTUBE_PUBLISHING_ENABLED=true
# Obtain the refresh token once via: node scripts/oauth-youtube.mjs
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional safety verification channel (used later via channels.list(mine=true)).
YOUTUBE_CHANNEL_ID=
# Optional overrides; defaults are shown.
# YOUTUBE_CATEGORY_ID=27
# YOUTUBE_LANGUAGE=en
# YOUTUBE_MADE_FOR_KIDS=false
# YOUTUBE_SYNTHETIC_MEDIA=true
# YOUTUBE_PRIVACY_STATUS=private
# YOUTUBE_PUBLISH_AT=2026-08-14T18:00:00Z   (requires privacyStatus private)
# YOUTUBE_PLAYLIST_IDS=PLxxxx,PLyyyy

# Google Sheets write-back of publish records (Video ID, Category, Topic,
# Title, Status, YouTube ID, URL, Privacy, Scheduled At, Published At,
# Duration). Optional; auth reuses YOUTUBE_* credentials. Enabling requires
# re-running scripts/oauth-youtube.mjs to mint a refresh token that includes
# the spreadsheets scope.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_SHEET_NAME=Sheet1


# Set true to generate video assets (runway provider). Off by default:
# "video" scenes fall back to image generation until video is supported.
ENABLE_VIDEO_ASSETS=false

# ============================================================================
# Optional; sane defaults if unset
# ============================================================================
# NODE_ENV=development
# IMAGE_PROVIDER_URL=http://localhost:8020
# TTS_URL=http://localhost:8010
# WhisperX word-level alignment service (separate process on :8030)
# Local development
TRANSCRIBER_URL=http://localhost:8030
# ARTIFACT_STORE_ENABLED=false
# ARTIFACT_STORE_DIR=runs
# SOURCE_ASSET_CACHE_DIR=cache/source-assets
# NARRATIVE_HOLD_SECONDS=0.5
# THUMBNAIL_FONT_PATH=assets/branding/NotoSans-Bold.ttf
# THUMBNAIL_MODE=auto            # auto | full | overlay. auto: full-typography, fall back to overlay if QA fails.
# THUMBNAIL_QA=true              # auto mode: enable visual QA; full mode always requires QA
# MODEL_THUMBNAILQA=openai/gpt-4o-mini   # vision-capable model used for thumbnail QA
NARRATION_TARGET_WPM=140