{
  "name": "gemini-image-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "gemini-image": "./bin/gemini-image.mjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli/cli.ts",
    "build": "tsc",
    "test:integration": "tsx --test tests/reference-upload.integration.test.ts",
    "serve": "tsx src/http/server.ts",
    "start": "tsx src/cli/cli.ts",
    "lint": "oxlint src --config ../../.oxlintrc.json --import-plugin --deny-warnings --type-aware",
    "lint:fix": "oxlint src --config ../../.oxlintrc.json --import-plugin --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "postinstall": "playwright install chromium 2>/dev/null || true",
    "test": "tsx --test tests/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@fastify/cors": "^11.3.0",
    "commander": "^15.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.10.0",
    "playwright": "^1.52.0",
    "tsx": "^4.23.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
