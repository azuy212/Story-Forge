# Copy this over:
# cp .env.example .env
# Then modify to suit your needs

# TTS backend: "chatterbox" (local service on TTS_URL) or "openrouter"
# (OpenRouter /api/v1/audio/speech). When set to anything other than
# "chatterbox", the admin UI does not register/poll the local TTS service.
# Keep this in sync with TTS_PROVIDER in apps/orchestrator/.env.
# TTS_PROVIDER=chatterbox

# Provider URLs (defaults are shown; all optional)
# TTS_URL=http://localhost:8010
# IMAGE_PROVIDER_URL=http://localhost:8020
# TRANSCRIBER_URL=http://localhost:8030
# ADMIN_UI_PORT=2025