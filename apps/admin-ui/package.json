{
  "name": "admin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local control panel for the YouTube Shorts pipeline and providers",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,ui --prefix-colors cyan,magenta \"pnpm dev:server\" \"pnpm dev:ui\"",
    "dev:server": "tsx watch server/index.mjs",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/http-proxy": "^11.3.0",
    "@fastify/static": "^8.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3",
    "vite": "^5.4.11"
  }
}
